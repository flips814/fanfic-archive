# Everything here is OPTIONAL. You can start with no .env at all:
#   docker compose up -d --build
#   docker compose logs web        # copy the first-time setup code
#   open http://localhost:8000/setup
# Admins can change every setting below (except database, SECRET_KEY and DEV_LOGIN)
# in the web UI under Admin; values set there override this file.

# --- Core -------------------------------------------------------------------
SITE_NAME=Fanfic Archive
# Public URL users reach the app on (used for OIDC redirect + links in notifications)
BASE_URL=http://localhost:8000
WEB_PORT=8000
# Leave empty to have one generated on first launch and stored in the database.
# Encrypts sessions, saved site logins and secret settings: changing it means
# users must sign in again and re-enter saved passwords.
SECRET_KEY=

POSTGRES_USER=fanfic
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=fanfic

# --- OIDC login (Authentik, Authelia, Keycloak, Zitadel, Pocket ID, Google, ...) ---
# Redirect URI to register at your provider:  ${BASE_URL}/auth/callback
# Post-logout redirect URI:                    ${BASE_URL}/
OIDC_PROVIDER_NAME=SSO
OIDC_ISSUER=https://auth.example.com/application/o/fanfic-archive
# OIDC_DISCOVERY_URL=   # only if discovery isn't at ${OIDC_ISSUER}/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
# Admins (can delete any work / toggle auto-update): by email and/or group claim
ADMIN_EMAILS=
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUP=
# Local testing ONLY: log in without SSO at /dev-login?as=alice
DEV_LOGIN=false

# --- Update checking ---------------------------------------------------------
# How often in-progress works are checked for new chapters
UPDATE_INTERVAL_MINUTES=360
# How often completed works are re-checked (0 = never)
COMPLETED_UPDATE_INTERVAL_MINUTES=10080
# Pause between works, to be polite to the sites
DELAY_BETWEEN_WORKS_SECONDS=5
WORKER_POLL_SECONDS=10

# --- Importers ---------------------------------------------------------------
# Skip "are you 18+" interstitials (AO3 explicit works, etc.)
FANFICFARE_IS_ADULT=true
# FlareSolverr gets past Cloudflare on FanFiction.net / FictionPress.
# COMPOSE_PROFILES starts the flaresolverr container; FLARESOLVERR_URL makes the app use it.
# Remove both lines to turn it off.
COMPOSE_PROFILES=flaresolverr
FLARESOLVERR_URL=http://flaresolverr:8191
# Sites (FanFicFare domains) that go through FlareSolverr
FLARESOLVERR_SITES=www.fanfiction.net,www.fictionpress.com

# --- Notifications -----------------------------------------------------------
# Server-wide channels: get every "new work imported" and "new chapter" event.
# Users configure their own Discord/email/Apprise channels in the web UI.
DISCORD_WEBHOOK_URL=
# Any Apprise URLs, comma separated (https://github.com/caronc/apprise/wiki)
APPRISE_URLS=

# Email (used for per-user email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Fanfic Archive <fanfic@example.com>
SMTP_STARTTLS=true
SMTP_SSL=false
